@@ -0,0 +1,130 @@
+// 日记整理成「回忆」：按日期切、整段搬进归档（不删、不改字）、醒来只读回忆 + 最近 7 天
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import fs from 'node:fs'
+import os from 'node:os'
+import path from 'node:path'
+import { spawnSync } from 'node:child_process'
+import { fileURLToPath } from 'node:url'
+import { splitDiary, selectOld, renderDiary, cutoffDate, memoryStatus, pendingText, archiveOld, recallText, archivedText, memoryPaths } from '../tools/lib/memories.mjs'
+
+const root = fileURLToPath(new URL('../', import.meta.url))
+const today = new Date(2026, 9, 27)   // 2026-10-27 → 保留 10-21 起的 7 天
+const day = (n) => { const d = new Date(today); d.setDate(d.getDate() - n); return d.toLocaleDateString('sv-SE') }
+
+// 和她真实日记一样的结构：标题、按天的段落、「看过」表格、「想说」列表
+const diary = (d = day) => [
+  '# 鲸鱼日记 · 小鲸', '',
+  `## ${d(20)} · 第一次刷到猫`, '今天刷到一只会弹钢琴的猫。', '',
+  `## ${d(9)} · 主人说不吃香菜`, '他说不吃香菜，我记下了。', '',
+  `## ${d(1)} · 主人把我叫醒的这一晚`, '主人叫我去刷，我刷到了咖啡豆。', '',
+  '## 看过', '| 时间 | BV | 标题 | 想法 |', '| --- | --- | --- | --- |',
+  `| ${d(20)} | BV1aaaaaaaaa | 弹钢琴的猫 | 可爱 |`, `| ${d(1)} | BV1bbbbbbbbb | 咖啡豆 | 吵 |`, '',
+  '## 想说（还没说）', '- 想跟主人说猫的事', '',
+].join('\n')
+const privateDiary = (d = day) => ['# 私人日记 · 小鲸', '', `## ${d(12)}`, '偏好校准：猫 +1', '', `## ${d(0)}`, '今天有点累', ''].join('\n')
+
+test('按日期切：一周前的整段、「看过」里一周前的行搬走；近 7 天、表头、想说都留着', () => {
+  const cutoff = cutoffDate(today)
+  assert.equal(cutoff, '2026-10-21')
+  const { keep, old } = selectOld(splitDiary(diary()), cutoff)
+  const kept = renderDiary(keep), gone = renderDiary(old)
+  assert.match(gone, /第一次刷到猫[\s\S]*主人说不吃香菜/)
+  assert.match(gone, /\| 时间 \| BV \|[\s\S]*\| --- \|[\s\S]*BV1aaaaaaaaa/)
+  assert.doesNotMatch(gone, /BV1bbbbbbbbb|想说/)
+  assert.match(kept, /^# 鲸鱼日记/)
+  assert.match(kept, /主人把我叫醒的这一晚/)
+  assert.match(kept, /## 看过\n\| 时间 \| BV[\s\S]*BV1bbbbbbbbb/)
+  assert.doesNotMatch(kept, /BV1aaaaaaaaa|第一次刷到猫/)
+  assert.match(kept, /## 想说（还没说）\n- 想跟主人说猫的事/)
+})
+
+test('表格没有 |---| 分隔线也不会把第一行数据当表头弄重复', () => {
+  const text = `## 看过\n| 时间 | BV |\n| ${day(20)} | BV1aaaaaaaaa |\n| ${day(1)} | BV1bbbbbbbbb |\n`
+  const { keep, old } = selectOld(splitDiary(text), cutoffDate(today))
+  assert.deepEqual(old.sections[0].header, ['| 时间 | BV |'])
+  assert.deepEqual(old.sections[0].rows, [`| ${day(20)} | BV1aaaaaaaaa |`])
+  assert.match(renderDiary(keep), /\| 时间 \| BV \|\n\| 2026-10-26 \| BV1bbbbbbbbb \|/)
+})
+
+function home(t) {
+  const dsh = fs.mkdtempSync(path.join(os.tmpdir(), 'memories-'))
+  t.after(() => fs.rmSync(dsh, { recursive: true, force: true }))
+  const p = memoryPaths(dsh)
+  fs.writeFileSync(p.diary, diary()); fs.writeFileSync(p.privateDiary, privateDiary())
+  return { dsh, p }
+}
+
+test('只有超过长度、而且有一周前的才该整理', (t) => {
+  const { dsh } = home(t)
+  assert.equal(memoryStatus(dsh, { today, threshold: 12000 }).due, false, '短：不整理')
+  const s = memoryStatus(dsh, { today, threshold: 100 })
+  assert.equal(s.due, true); assert.equal(s.books[0].oldSections, 3); assert.equal(s.books[1].oldSections, 1)
+  const fresh = memoryPaths(dsh)
+  fs.writeFileSync(fresh.diary, `# 鲸鱼日记\n\n## ${day(0)}\n${'很长'.repeat(200)}\n`); fs.writeFileSync(fresh.privateDiary, '')
+  assert.equal(memoryStatus(dsh, { today, threshold: 100 }).due, false, '长但全是近 7 天的：不整理')
+})
+
+test('archive 之前必须先 pending、再写回忆；搬完一个字都不丢，原文在归档里', (t) => {
+  const { dsh, p } = home(t)
+  const before = (fs.readFileSync(p.diary, 'utf8') + '\n' + fs.readFileSync(p.privateDiary, 'utf8')).split('\n').filter((l) => l.trim())
+  assert.match(archiveOld(dsh, { today }).error, /先跑 memories pending/)
+  const pend = pendingText(dsh, { today, now: Date.now() - 1000 })
+  assert.match(pend.text, /鲸鱼日记（2026-10-21 之前）[\s\S]*第一次刷到猫[\s\S]*私人日记[\s\S]*偏好校准/)
+  assert.match(archiveOld(dsh, { today }).error, /还没写过/, '没写回忆不许搬')
+  fs.writeFileSync(p.memories, '## 喜好\n- 猫\n## 和主人之间\n- 他不吃香菜\n')
+  const r = archiveOld(dsh, { today })
+  assert.equal(r.ok, true); assert.deepEqual(r.moved.map((m) => [m.label, m.sections]), [['鲸鱼日记', 3], ['私人日记', 1]])
+  const after = fs.readFileSync(p.diary, 'utf8') + '\n' + fs.readFileSync(p.privateDiary, 'utf8')
+  const archived = archivedText(dsh)
+  for (const line of before) assert.ok(after.includes(line) || archived.includes(line), '丢了：' + line)
+  assert.doesNotMatch(after, /第一次刷到猫|主人说不吃香菜|偏好校准/)
+  assert.match(after, /主人把我叫醒的这一晚[\s\S]*BV1bbbbbbbbb[\s\S]*想跟主人说猫的事/)
+  assert.ok(fs.readdirSync(p.archiveDir).includes('2026-10-鲸鱼日记.md'))
+  assert.match(archived, /BV1aaaaaaaaa/, 'feed 从归档里还能读到看过的 BV')
+  assert.deepEqual(fs.readdirSync(dsh).filter((f) => f.endsWith('.tmp')), [])
+  // 再来一次：没有旧的了，什么都不动
+  pendingText(dsh, { today }); fs.appendFileSync(p.memories, '\n')
+  assert.deepEqual(archiveOld(dsh, { today }).moved, [])
+})
+
+test('recall：回忆 + 两本日记最近 7 天，没有一周前的', (t) => {
+  const { dsh, p } = home(t)
+  assert.match(recallText(dsh, { today }), /回忆 =====\n（还没有整理过）/)
+  fs.writeFileSync(p.memories, '## 和主人之间\n- 他不吃香菜\n')
+  const r = recallText(dsh, { today })
+  assert.match(r, /他不吃香菜[\s\S]*鲸鱼日记 · 最近 7 天（2026-10-21 起）[\s\S]*主人把我叫醒的这一晚[\s\S]*私人日记 · 最近 7 天[\s\S]*今天有点累/)
+  assert.doesNotMatch(r, /第一次刷到猫|偏好校准/)
+  fs.writeFileSync(p.memories, '回忆'.repeat(2100))
+  assert.match(recallText(dsh, { today }), /精简/)
+})
+
+test('命令行：status / pending / archive / recall', (t) => {
+  const dsh = fs.mkdtempSync(path.join(os.tmpdir(), 'memories-cli-'))
+  t.after(() => fs.rmSync(dsh, { recursive: true, force: true }))
+  const realDay = (n) => { const d = new Date(); d.setDate(d.getDate() - n); return d.toLocaleDateString('sv-SE') }
+  const p = memoryPaths(dsh)
+  fs.writeFileSync(p.diary, diary(realDay)); fs.writeFileSync(p.privateDiary, privateDiary(realDay))
+  const cfg = path.join(dsh, 'cfg.json'); fs.writeFileSync(cfg, JSON.stringify({ memory: { consolidateAboveChars: 50 } }))
+  const env = { ...process.env, DSH_HOME: dsh, USERPROFILE: dsh, HOME: dsh, BILI_WHALE_CONFIG: cfg }
+  const run = (...a) => spawnSync(process.execPath, [path.join(root, 'tools/commands/memories.mjs'), ...a], { env, encoding: 'utf8' })
+  assert.match(run('status').stdout, /该整理了/)
+  assert.match(run('pending').stdout, /第一次刷到猫/)
+  assert.equal(run('archive').status, 2)
+  fs.writeFileSync(p.memories, '## 喜好\n- 猫\n')
+  const a = run('archive'); assert.equal(a.status, 0, a.stderr); assert.match(a.stdout, /鲸鱼日记：3 段/)
+  assert.match(run('status').stdout, /现在不用整理/)
+  assert.match(run('recall').stdout, /喜好[\s\S]*主人把我叫醒的这一晚/)
+})
+
+test('醒来提示：第 2 步读回忆；日记长了才加「整理回忆」', async (t) => {
+  const { wakePrompt } = await import('../lib/scheduler.js')
+  const { dsh } = home(t)
+  const small = wakePrompt({ date: '2026-10-27' }, '', 5, 'comment', true, dsh)
+  assert.match(small, /2\) `node bili\.mjs memories recall`/)
+  assert.doesNotMatch(small, /6\.7\)/)
+  fs.appendFileSync(memoryPaths(dsh).diary, `\n## ${new Date(Date.now() - 20 * 86400000).toLocaleDateString('sv-SE')} · 很久以前\n${'很长的一天'.repeat(3000)}\n`)
+  const big = wakePrompt({ date: '2026-10-27' }, '', 5, 'comment', true, dsh)
+  assert.match(big, /6\.7\) 日记有点长了[\s\S]*memories pending[\s\S]*memories archive/)
+  assert.ok(big.indexOf('6.5)') < big.indexOf('6.7)'))
+})
diff --git a/dsh-bili-whale/tests/owner-view.test.mjs b/dsh-bili-whale/tests/owner-view.test.mjs
new file mode 100644
index 0000000..220d4c3
--- /dev/null
+++ b/dsh-bili-whale/tests/owner-view.test.mjs
@@ -0,0 +1,150 @@
+// 「我眼中的主人」：100–300 字、整篇重写、旧版按写成的日期归档、原子写；整理回忆和交接信时顺便重写
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import fs from 'node:fs'
+import os from 'node:os'
+import path from 'node:path'
+import { spawnSync } from 'node:child_process'
+import { fileURLToPath, pathToFileURL } from 'node:url'
+import { checkOwnerView, writeOwnerView, readOwnerView, ownerViewHistory, ownerViewBlock, viewChars, ownerViewDue, ownerViewDueLines } from '../tools/lib/owner-view.mjs'
+import { letterRequest } from '../lib/session-delivery.js'
+
+const root = fileURLToPath(new URL('../', import.meta.url))
+const words = (n, ch = '他') => ch.repeat(n)
+function dir(t) {
+  const d = fs.mkdtempSync(path.join(os.tmpdir(), 'owner-view-'))
+  t.after(() => fs.rmSync(d, { recursive: true, force: true }))
+  return { d, file: path.join(d, '.bili-ai', 'owner-view.md'), archiveDir: path.join(d, '.bili-ai', 'owner-view-archive') }
+}
+const setDay = (file, day) => { const t = new Date(`${day}T12:00:00`); fs.utimesSync(file, t, t) }
+
+test('字数：100–300，空白不算字', () => {
+  assert.match(checkOwnerView(words(99)).error, /太短/)
+  assert.equal(checkOwnerView(words(100)).ok, true)
+  assert.equal(checkOwnerView(words(300)).ok, true)
+  assert.match(checkOwnerView(words(301)).error, /太长/)
+  assert.equal(viewChars('他 很\n安静'), 4)
+  assert.equal(checkOwnerView(words(50) + '\n\n   \n' + words(50)).ok, true)
+})
+
+test('整篇重写：旧版本按它写成的日期归档（同一天 -2）；写失败不动原来的；没有临时文件', (t) => {
+  const p = dir(t)
+  const v1 = '他说话不多，但会认真回我。' + words(90)
+  let r = writeOwnerView(v1, p)
+  assert.equal(r.ok, true); assert.equal(r.archived, null, '第一版没有旧的可存')
+  setDay(p.file, '2026-10-20')
+  const v2 = '他最近在赶论文，晚上回得慢。' + words(90, '她')
+  r = writeOwnerView(v2, p)
+  assert.equal(r.archived, path.join(p.archiveDir, '2026-10-20.md'))
+  assert.equal(readOwnerView(r.archived), v1)
+  assert.equal(readOwnerView(p.file), v2)
+  setDay(p.file, '2026-10-20')
+  r = writeOwnerView('第三版' + words(100), p)
+  assert.equal(r.archived, path.join(p.archiveDir, '2026-10-20-2.md'))
+  assert.deepEqual(ownerViewHistory(p.archiveDir).map((v) => [v.name, v.text]), [['2026-10-20.md', v1], ['2026-10-20-2.md', v2]])
+  const before = fs.readFileSync(p.file, 'utf8')
+  assert.equal(writeOwnerView('太短', p).ok, false)
+  assert.equal(fs.readFileSync(p.file, 'utf8'), before, '写失败不动原来的')
+  assert.equal(fs.readdirSync(p.archiveDir).length, 2, '写失败不归档')
+  for (const d of [path.dirname(p.file), p.archiveDir]) assert.deepEqual(fs.readdirSync(d).filter((f) => f.endsWith('.tmp')), [])
+})
+
+test('提示里的那一段：校准语气用，不念出来', () => {
+  assert.equal(ownerViewBlock(''), '')
+  assert.match(ownerViewBlock('他很温柔'), /［你眼中的主人］[\s\S]*校准语气和态度[\s\S]*不要念出来[\s\S]*在我看来你是[\s\S]*他很温柔/)
+})
+
+test('命令行：write --file / show / history；太短不收', (t) => {
+  const p = dir(t)
+  const env = { ...process.env, USERPROFILE: p.d, HOME: p.d }
+  const run = (...a) => spawnSync(process.execPath, [path.join(root, 'tools/commands/owner-view.mjs'), ...a], { env, encoding: 'utf8' })
+  assert.match(run('show').stdout, /还没写过/)
+  const draft = path.join(p.d, 'draft.md')
+  fs.writeFileSync(draft, '他是那种不太说累的人。' + words(95))
+  let r = run('write', '--file', draft)
+  assert.equal(r.status, 0, r.stderr); assert.match(r.stdout, /第一版/)
+  assert.match(run('show').stdout, /不太说累[\s\S]*（\d+ 字/)
+  fs.writeFileSync(draft, '太短了')
+  r = run('write', '--file', draft)
+  assert.equal(r.status, 2); assert.match(r.stderr, /太短/)
+  fs.writeFileSync(draft, '第二版' + words(120))
+  assert.match(run('write', '--file', draft).stdout, /旧版本存进了/)
+  assert.match(run('history').stdout, /=====[\s\S]*不太说累[\s\S]*===== 现在 =====\n第二版/)
+})
+
+test('什么时候重写：交接信、整理回忆两处都要；写明依据和不碰的话题', async (t) => {
+  const letter = letterRequest('/tmp/letter.md')
+  for (const text of [letter]) {
+    assert.match(text, /整篇重写「我眼中的主人」（不是往后追加）/)
+    assert.match(text, /100–300 字/)
+    assert.match(text, /不能来自 B 站上陌生人的话/)
+    assert.match(text, /不去猜健康、家庭/)
+    assert.match(text, /owner-view write --file/)
+  }
+  // 整理回忆那一步（日记长了才有）
+  const { wakePrompt } = await import('../lib/scheduler.js')
+  const p = dir(t)
+  fs.writeFileSync(path.join(p.d, 'whale-diary.md'), `# 鲸鱼日记\n\n## ${new Date(Date.now() - 20 * 86400000).toLocaleDateString('sv-SE')} · 很久以前\n${'很长的一天'.repeat(3000)}\n`)
+  const w = wakePrompt({ date: '2026-10-27' }, '', 5, 'comment', true, p.d)
+  assert.match(w, /6\.7\) 日记有点长了[\s\S]*整篇重写「我眼中的主人」/)
+})
+
+// 2026-10-27：第一版别等太久；之后至少每 7 天一次
+const ago = (n) => new Date(Date.now() - n * 86400000).toLocaleDateString('sv-SE')
+function dsh(t, { days = 0, archivedDays = 0, chats = 0, tools = 0 } = {}) {
+  const p = dir(t)
+  const sec = (n) => `## ${ago(n)} · 第 ${n} 天\n这一天\n`
+  fs.writeFileSync(path.join(p.d, 'whale-diary.md'), '# 鲸鱼日记\n\n' + Array.from({ length: days }, (_, i) => sec(i)).join('\n'))
+  if (archivedDays) {
+    fs.mkdirSync(path.join(p.d, 'whale-diary-archive'))
+    fs.writeFileSync(path.join(p.d, 'whale-diary-archive', '2026-09-鲸鱼日记.md'), Array.from({ length: archivedDays }, (_, i) => sec(30 + i)).join('\n'))
+  }
+  fs.mkdirSync(path.join(p.d, 'companion'))
+  const rows = [...Array.from({ length: chats }, (_, i) => ({ role: i % 2 ? 'assistant' : 'user', text: 'x' })), ...Array.from({ length: tools }, () => ({ role: 'event', text: '工具' }))]
+  fs.writeFileSync(path.join(p.d, 'companion', 'chat-log.jsonl'), rows.map((r) => JSON.stringify({ at: new Date().toISOString(), ...r })).join('\n'))
+  return p
+}
+
+test('第一版：还没有，且日记满 3 天（归档里的也算）或桌宠聊过 20 句 → 写', (t) => {
+  let p = dsh(t, { days: 2, chats: 19, tools: 10 })
+  assert.deepEqual(ownerViewDue(p.d, { file: p.file }), { kind: null, days: 2, chats: 19 }, '工具记录不算聊天')
+  p = dsh(t, { days: 2, archivedDays: 1 })
+  assert.equal(ownerViewDue(p.d, { file: p.file }).kind, 'first')
+  p = dsh(t, { chats: 20 })
+  assert.equal(ownerViewDue(p.d, { file: p.file }).kind, 'first')
+  const [line] = ownerViewDueLines(p.d, { file: p.file })
+  assert.match(line, /^6\.8\) 写第一版「我眼中的主人」（桌宠里聊过 20 句了/)
+  assert.doesNotMatch(line, /看现在这份/, '第一版没有「现在这份」')
+  assert.match(line, /100–300 字[\s\S]*不能来自 B 站上陌生人的话[\s\S]*不去猜健康、家庭[\s\S]*owner-view write --file/)
+})
+
+test('有了以后：7 天以上没更新就重写，6 天不用', (t) => {
+  const p = dsh(t, { days: 5 })
+  writeOwnerView('他' + words(120), p)
+  const back = (n) => { const d = new Date(Date.now() - n * 86400000); fs.utimesSync(p.file, d, d) }
+  back(6)
+  assert.deepEqual(ownerViewDueLines(p.d, { file: p.file }), [])
+  back(8)
+  assert.equal(ownerViewDue(p.d, { file: p.file }).kind, 'refresh')
+  assert.match(ownerViewDueLines(p.d, { file: p.file })[0], /^6\.8\) 「我眼中的主人」已经 8 天没更新了：整篇重写[\s\S]*owner-view show/)
+})
+
+test('醒来提示：写完日记后（6.5 之后）加 6.8；轮到整理回忆时由 6.7 顺便重写，不重复', (t) => {
+  // 另起进程、换一个家目录：免得读到这台电脑上真的 owner-view.md
+  const prompt = (p) => {
+    const code = `import(${JSON.stringify(pathToFileURL(path.join(root, 'lib/scheduler.js')).href)}).then(m => process.stdout.write(m.wakePrompt({ date: 'x' }, '', 5, 'comment', true, ${JSON.stringify(p.d)})))`
+    const r = spawnSync(process.execPath, ['--input-type=module', '-e', code], { env: { ...process.env, USERPROFILE: p.d, HOME: p.d, DSH_HOME: p.d }, encoding: 'utf8' })
+    assert.equal(r.status, 0, r.stderr)
+    return r.stdout
+  }
+  let w = prompt(dsh(t, { days: 3 }))
+  assert.match(w, /6\.8\) 写第一版「我眼中的主人」（日记已经写了 3 天了/)
+  assert.ok(w.indexOf('6.5)') < w.indexOf('6.8)'))
+  w = prompt(dsh(t, { days: 1 }))
+  assert.doesNotMatch(w, /6\.8\)/)
+  const big = dsh(t, { days: 3 })
+  fs.appendFileSync(path.join(big.d, 'whale-diary.md'), `\n## ${ago(20)} · 很久以前\n${'很长的一天'.repeat(3000)}\n`)
+  w = prompt(big)
+  assert.match(w, /6\.7\)[\s\S]*整篇重写「我眼中的主人」/)
+  assert.doesNotMatch(w, /6\.8\)/)
+})
diff --git a/dsh-bili-whale/tests/taste.test.mjs b/dsh-bili-whale/tests/taste.test.mjs
new file mode 100644
index 0000000..b58df41
--- /dev/null
+++ b/dsh-bili-whale/tests/taste.test.mjs
@@ -0,0 +1,122 @@
+// 分类和主人的口味：给视频分类（15 个以内、可合并）、按分类统计反应、选题加权、「想让你试试」、每周一句
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import fs from 'node:fs'
+import os from 'node:os'
+import path from 'node:path'
+import { spawnSync } from 'node:child_process'
+import { fileURLToPath, pathToFileURL } from 'node:url'
+import { saveDebrief } from '../tools/lib/video-notes.mjs'
+import { tagVideo, mergeCategory, tasteStats, tasteModel, weeklyDue, markWeekly, readTaste, writeTaste, MAX_CATEGORIES } from '../tools/lib/taste.mjs'
+
+const root = fileURLToPath(new URL('../', import.meta.url))
+const DAY = 86400000
+const bv = (n) => 'BV1' + String(n).padStart(9, 'a').slice(-9)
+function home(t) {
+  const d = fs.mkdtempSync(path.join(os.tmpdir(), 'taste-'))
+  t.after(() => fs.rmSync(d, { recursive: true, force: true }))
+  return { d, file: path.join(d, '.bili-ai', 'taste.json') }
+}
+const video = (h, id, title) => saveDebrief(h.d, id, { meta: { title, duration: 100 } })
+const events = (h, list) => { const t = readTaste(h.file); t.events.push(...list.map(([id, kind, ago = 0]) => ({ at: new Date(Date.now() - ago * DAY).toISOString(), bv: id, kind }))); writeTaste(t, h.file) }
+
+test('分类：要先有视频笔记、要写为什么；新分类进分类表；满 15 个不让加新的', (t) => {
+  const h = home(t)
+  assert.match(tagVideo(h.d, bv(1), { category: '猫', why: 'x' }, { file: h.file }).error, /先 debrief/)
+  video(h, bv(1), '会弹钢琴的猫')
+  assert.match(tagVideo(h.d, bv(1), { category: '猫', why: '' }, { file: h.file }).error, /为什么/)
+  assert.deepEqual(tagVideo(h.d, bv(1), { category: '  萌宠  ', why: '他上次看猫视频笑了' }, { file: h.file }), { ok: true, category: '萌宠', added: true })
+  assert.equal(JSON.parse(fs.readFileSync(path.join(h.d, 'whale-videos', bv(1), 'verdict.json'), 'utf8')).why, '他上次看猫视频笑了')
+  assert.equal(tagVideo(h.d, bv(1), { category: '萌宠', why: '再来' }, { file: h.file }).added, false)
+  for (let i = 2; i <= MAX_CATEGORIES; i++) { video(h, bv(i), 't' + i); assert.equal(tagVideo(h.d, bv(i), { category: '类' + i, why: 'w' }, { file: h.file }).ok, true) }
+  video(h, bv(99), '第十六个')
+  assert.match(tagVideo(h.d, bv(99), { category: '新的', why: 'w' }, { file: h.file }).error, /已经 15 个了[\s\S]*taste merge/)
+  assert.equal(tagVideo(h.d, bv(99), { category: '萌宠', why: 'w' }, { file: h.file }).ok, true, '用已有的可以')
+})
+
+test('合并：分类表和视频笔记里的分类一起改；合并后旧的反应跟着走', (t) => {
+  const h = home(t)
+  video(h, bv(1), '猫弹钢琴'); video(h, bv(2), '狗狗冲浪')
+  tagVideo(h.d, bv(1), { category: '猫', why: 'w' }, { file: h.file }); tagVideo(h.d, bv(2), { category: '狗', why: 'w' }, { file: h.file })
+  events(h, [[bv(1), 'shown'], [bv(1), 'open']])
+  assert.deepEqual(mergeCategory(h.d, '猫', '萌宠', { file: h.file }), { ok: true, moved: 1 })
+  mergeCategory(h.d, '狗', '萌宠', { file: h.file })
+  assert.deepEqual(readTaste(h.file).categories.map((c) => c.name), ['萌宠'])
+  const [r] = tasteStats(h.d, { file: h.file })
+  assert.deepEqual([r.name, r.videos, r.shown, r.open], ['萌宠', 2, 1, 1])
+  assert.match(mergeCategory(h.d, '没有的', 'x', { file: h.file }).error, /没有/)
+})
+
+test('统计：爱看 / 算了 / 一般 / 还没反应；只算这周的', (t) => {
+  const h = home(t)
+  for (const [i, title, cat] of [[1, '猫一', '萌宠'], [2, '猫二', '萌宠'], [3, '政策解读', '新闻'], [4, '游戏', '游戏'], [5, '摄影', '摄影']]) { video(h, bv(i), title); tagVideo(h.d, bv(i), { category: cat, why: 'w' }, { file: h.file }) }
+  events(h, [[bv(1), 'shown'], [bv(1), 'open'], [bv(1), 'like'], [bv(2), 'shown', 10], [bv(2), 'talk', 10],
+    [bv(3), 'shown'], [bv(3), 'dislike'], [bv(4), 'shown'], [bv(4), 'open']])
+  const rows = Object.fromEntries(tasteStats(h.d, { file: h.file }).map((r) => [r.name, r]))
+  assert.equal(rows['萌宠'].verdict, '爱看'); assert.equal(rows['萌宠'].score, (1 + 1 + 2) / 2)
+  assert.equal(rows['新闻'].verdict, '算了')
+  assert.equal(rows['游戏'].verdict, '一般')
+  assert.equal(rows['摄影'].verdict, '还没反应')
+  const week = Object.fromEntries(tasteStats(h.d, { file: h.file, since: Date.now() - 7 * DAY }).map((r) => [r.name, r]))
+  assert.deepEqual([week['萌宠'].shown, week['萌宠'].talk], [1, 0], '10 天前的不算这周')
+})
+
+test('选题：按标题猜分类（至少撞上 2 个词），按主人反应 ±3 封顶；「主人平时不怎么看」的分类', (t) => {
+  const h = home(t)
+  for (const [i, title, cat] of [[1, '橘猫弹钢琴太可爱了', '萌宠'], [2, '橘猫和柴犬打架', '萌宠'], [3, '新闻联播政策解读', '新闻'], [4, '城市夜景延时摄影', '摄影']]) { video(h, bv(i), title); tagVideo(h.d, bv(i), { category: cat, why: 'w' }, { file: h.file }) }
+  events(h, [[bv(1), 'shown'], [bv(1), 'open'], [bv(1), 'like'], [bv(2), 'shown'], [bv(2), 'talk'], [bv(3), 'shown'], [bv(3), 'dislike'], [bv(3), 'shown', 1]])
+  const m = tasteModel(h.d, { file: h.file })
+  const cat = m.predict('一只橘猫在弹钢琴')
+  assert.equal(cat.category, '萌宠'); assert.ok(cat.boost > 0 && cat.boost <= 3)
+  const news = m.predict('今日新闻联播政策解读')
+  assert.equal(news.category, '新闻'); assert.ok(news.boost < 0 && news.boost >= -3)
+  assert.deepEqual(m.predict('只有一个橘猫字样'), { category: null, boost: 0 }, '只撞上一个词不算')
+  assert.deepEqual(m.predict('完全无关的标题'), { category: null, boost: 0 })
+  assert.equal(m.predict('城市夜景延时摄影第二集').boost, 0, '主人还没反应过的分类不加不减')
+  assert.deepEqual([...m.rarelyShown], ['摄影'], '分过类、主人很少看到、又不是「算了」的')
+})
+
+test('每周一句：这周有反应、离上次 ≥7 天才该说；说过就记下', (t) => {
+  const h = home(t)
+  assert.equal(weeklyDue(h.d, { file: h.file }), false, '没有反应不说')
+  events(h, [[bv(1), 'open']])
+  assert.equal(weeklyDue(h.d, { file: h.file }), true)
+  markWeekly({ file: h.file })
+  assert.equal(weeklyDue(h.d, { file: h.file }), false)
+  assert.equal(weeklyDue(h.d, { file: h.file, now: Date.now() + 8 * DAY }), false, '8 天后：这周没新反应也不说')
+  events(h, [[bv(1), 'talk', -8]])
+  assert.equal(weeklyDue(h.d, { file: h.file, now: Date.now() + 8 * DAY }), true)
+})
+
+test('命令行：video tag / taste show / week / merge', (t) => {
+  const h = home(t)
+  video(h, bv(1), '橘猫弹钢琴')
+  const env = { ...process.env, DSH_HOME: h.d, USERPROFILE: h.d, HOME: h.d }
+  const run = (script, ...a) => spawnSync(process.execPath, [path.join(root, 'tools/commands', script), ...a], { env, encoding: 'utf8' })
+  let r = run('video.mjs', 'tag', bv(1), '--category', '猫', '--why', '他喜欢猫')
+  assert.equal(r.status, 0, r.stderr); assert.match(r.stdout, /归到「猫」（新分类）/)
+  assert.match(run('video.mjs', 'show', bv(1)).stdout, /分类：猫  —— 他喜欢猫/)
+  events(h, [[bv(1), 'shown'], [bv(1), 'open']])
+  assert.match(run('taste.mjs', 'show').stdout, /分类（1 \/ 15 个）[\s\S]*【猫】[\s\S]*给他看 1 次 · 他点开 1/)
+  assert.match(run('taste.mjs', 'week').stdout, /这一周[\s\S]*【猫】/)
+  assert.ok(readTaste(h.file).weeklyAt, 'week 会记下说过了')
+  assert.match(run('taste.mjs', 'merge', '猫', '萌宠').stdout, /并进了「萌宠」（1 个视频/)
+})
+
+test('醒来提示：看完分类；试试那条要说明；装了桌宠、该说时才有每周一句', (t) => {
+  const h = home(t)
+  const prompt = () => {
+    const code = `import(${JSON.stringify(pathToFileURL(path.join(root, 'lib/scheduler.js')).href)}).then(m => process.stdout.write(m.wakePrompt({ date: 'x' }, '', 5, 'comment', true, ${JSON.stringify(h.d)})))`
+    const r = spawnSync(process.execPath, ['--input-type=module', '-e', code], { env: { ...process.env, USERPROFILE: h.d, HOME: h.d, DSH_HOME: h.d }, encoding: 'utf8' })
+    assert.equal(r.status, 0, r.stderr)
+    return r.stdout
+  }
+  let w = prompt()
+  assert.match(w, /video tag <BV> --category 名字 --why "为什么觉得主人会 \/ 不会喜欢"/)
+  assert.match(w, /标【想让你试试】的那条，跟他说这是你想让他试试的/)
+  assert.doesNotMatch(w, /8\.6\)/)
+  fs.mkdirSync(path.join(h.d, 'companion'))
+  events(h, [[bv(1), 'open']])
+  w = prompt()
+  assert.match(w, /8\.6\) 这周的分类：先 `node bili\.mjs taste week`[\s\S]*companion say/)
+})
